# Copy this file to .env for local runs. In GitHub Actions, set these as repo secrets
# instead (Settings -> Secrets and variables -> Actions) -- see README for exact steps.

# https://the-odds-api.com/ -- sign up, free tier is fine to start.
ODDS_API_KEY=

# Message @BotFather on Telegram, /newbot, and paste the token it gives you.
TELEGRAM_BOT_TOKEN=

# Message your new bot once, then visit
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_CHAT_ID=

# Optional locally (defaults to a local sqlite file at data/betbot.db).
# REQUIRED for GitHub Actions, since the runner's filesystem doesn't persist between runs --
# use a free hosted Postgres DB (e.g. Supabase: Project Settings -> Database -> Connection
# string, "URI" tab). Example:
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=
